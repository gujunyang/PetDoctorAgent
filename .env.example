# ── LLM ────────────────────────────────────────────────────────────────────
LLM_MODEL_ID=deepseek-flash
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek 思考模式不支持强制 tool_choice，默认自动禁用；设为 0 可恢复
# LLM_DISABLE_THINKING=1

# ── 搜索工具（可选）────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key

# ── LangGraph 记忆系统 ─────────────────────────────────────────────────────
# 短期记忆 PostgresSaver + 长期记忆 PostgresStore 共用该连接串
DATABASE_URL=postgresql://user:password@localhost:5432/petclinic

# ── 会话 / 用户 ────────────────────────────────────────────────────────────
PET_USER_ID=default

# ── MCP 宠物店业务工具 ─────────────────────────────────────────────────────
# MCP Server 地址（启动：scripts/start_mcp.sh 或 python -m petdoctor.mcp_server.server）
PET_STORE_MCP_URL=http://localhost:8000/mcp

# ── RAG 知识库 ─────────────────────────────────────────────────────────────
# RAGMILL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# PET_RAG_DB=./data/rag/pet_knowledge.db
# 关闭检索结果的中文翻译（默认开启）
# PET_RAG_TRANSLATE=1
